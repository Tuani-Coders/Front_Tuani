      "commitment": { "title": "Social Commitment", "desc": "We work for and with the people who need it most." },
      "diversity": { "title": "Equality and Diversity", "desc": "We bet on an inclusive society where everyone adds up." },
      "sustainability": { "title": "Sustainability", "desc": "We develop viable projects with positive impact." }
